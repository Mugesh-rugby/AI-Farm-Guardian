# Local MySQL defaults: 127.0.0.1:3306, database farm_guardian, user root.
# Set this one value to your local MySQL root password.
MYSQL_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Optional integrations. Their pages report unavailable until configured.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENWEATHER_API_KEY=

# Optional; these defaults work for local development.
MODEL_CHECKPOINT=models/efficientnetv2_s.pth
MAX_UPLOAD_BYTES=10485760
